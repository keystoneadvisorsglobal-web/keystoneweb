<IfModule LiteSpeed>
CacheLookup off
</IfModule>

# Keystone Advisors - Servidor Web Apache / LiteSpeed

# Denegar acceso HTTP directo a bases de datos y archivos sensibles
<Files ~ "\.(sqlite|sqlite3|db|log|env|bak)$">
    Require all denied
    Order allow,deny
    Deny from all
</Files>

# Opciones de seguridad y endurecimiento de cabeceras HTTP
<IfModule mod_headers.c>
    # Ocultar huella de PHP y servidor web
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header unset Server
    Header always unset Server

    # Blindaje perimetral de cabeceras
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Bloquear acceso directo a carpeta data/ o archivos ocultos (.git, .env)
RewriteRule ^data/ - [F,L]
RewriteRule (^|/)\.(?!well-known) - [F,L]

# Redireccionar URLs heredadas o rezago de WordPress hacia la raíz con 301
RewriteRule ^(category|tag|author|feed|wp-json)/ - [R=301,L]
RewriteRule ^(protege-tus-datos-un-derecho-fundamental-en-la-era-digital|liderando-la-proxima-ola-de-innovacion-bancaria-con-agentforce|tu-factura-cloud-sigue-creciendo|5-claves-para-gestionar-un-equipo-de-ti-offshore-y-maximizar-tu-roi|la-ia-redefiniendo-la-innovacion-en-la-fuerza-laboral-y-el-futuro-del-trabajo|como-migrar-sistemas-heredados-hacia-tecnologias-modernas|salesforce-starter-suite|salesforce-starter|salesforce-quick-starter|asociaciones|reserva-tu-cita|servicios|contacto|hablemos-por-whatsapp|canal-de-denuncias-confidencial)/?$ / [R=301,L]

# Permitir archivos y directorios físicos reales (css, js, imágenes, robots.txt, sitemap.xml, landings activas)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Manejo de error 404 para cualquier ruta inexistente
ErrorDocument 404 /404.php
RewriteRule . /404.php [L]
</IfModule>
