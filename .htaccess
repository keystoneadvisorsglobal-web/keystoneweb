<IfModule LiteSpeed>
CacheLookup off
</IfModule>

# Keystone Advisors - Servidor Web Apache / LiteSpeed

# Denegar acceso HTTP directo a bases de datos y archivos sensibles
<Files ~ "\.(sqlite|sqlite3|db|log|env|bak)$">
    Require all denied
    Order allow,deny
    Deny from all
</Files>

# Opciones de seguridad y endurecimiento de cabeceras HTTP
<IfModule mod_headers.c>
    # Ocultar huella de PHP y servidor web
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header unset Server
    Header always unset Server

    # Blindaje perimetral de cabeceras
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Bloquear acceso directo a carpeta data/ o archivos ocultos (.git, .env)
RewriteRule ^data/ - [F,L]
RewriteRule (^|/)\.(?!well-known) - [F,L]

# Permitir archivos físicos reales (robots.txt, sitemap.xml, css, js, imágenes)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
